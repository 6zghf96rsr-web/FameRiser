# Demo is explicit and never accepts real payments. Turn off for production.
RANKME_DEMO=true
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Set to your exact public HTTPS origin. No trailing slash.
APP_URL=http://localhost:5173
# Random 32+ character HMAC secret. Never expose to the client.
ANALYTICS_SECRET=
# Enable real checkout only after configuring your business and legal pages.
PAYMENTS_ENABLED=false
SUPPORT_EMAIL=
BUSINESS_NAME=
BUSINESS_ADDRESS=
BUSINESS_ID=
# Google web OAuth app. Also used server-side for YouTube ownership proof.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local configuration helper only. These three keys need not be deployed to Sites.
SUPABASE_ACCESS_TOKEN=
APPLE_SERVICES_ID=
APPLE_CLIENT_SECRET=
# Local provider configuration only: consumed by auth:configure, not the browser.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Separate Meta app with Pages use case. Does not replace Supabase Facebook Login.
# Valid OAuth redirect: https://fameriser.com/auth/facebook-pages/callback
FACEBOOK_PAGES_APP_ID=
FACEBOOK_PAGES_APP_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
# Optional server-side fallback. Production uses migration 017 with Supabase Vault
# secret fameriser_resend_api_key and mail_settings.enabled; pg_cron runs each minute.
# Store keys only in Vault UI or the hosting secrets manager, never commit them.
# From address/domain must be verified with Resend. No SMTP passwords in the browser.
NOTICES_RESEND_API_KEY=
NOTICES_FROM_EMAIL=
# Dodo launch requires ALL approvals; do not set them before onboarding/review.
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PRODUCT_CZK=
DODO_PRODUCT_EUR=
DODO_PRODUCT_USD=
DODO_PRODUCT_PLN=
DODO_PRODUCT_JPY=
DODO_APPROVED=false
LEGAL_REVIEW_APPROVED=false
LEGACY_RANKING_RECONCILED=false
# Bearer credential for POST /api/internal/mail; server scheduler only.
MAIL_WORKER_SECRET=
